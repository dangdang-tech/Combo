# 本地直接运行模板。复制为 .env.local 后填写空值，不要提交真实凭据。
NODE_ENV=development
DATABASE_URL=postgres://combo:combo@localhost:5432/combo
REDIS_HOT_URL=redis://localhost:6380/0
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# 第一方邮箱验证码配置。本地模拟服务默认监听 4010 端口。
PUBLIC_APP_ORIGINS=http://localhost:5173,http://localhost:4173
SESSION_COOKIE_SECURE=false
RESEND_API_BASE_URL=http://127.0.0.1:4010
RESEND_API_KEY=
RESEND_FROM_EMAIL=Combo <auth@buildwithcombo.com>
OTP_HMAC_SECRET=

# 钱包充值（仅 Authoring API 使用）。默认关闭，不得填写 demo 或正式凭据。
LESHOUYING_ENABLED=false
LESHOUYING_ENVIRONMENT=TEST
LESHOUYING_PRODUCTION_ENABLED=false
LESHOUYING_INSTITUTION_NO=
LESHOUYING_MERCHANT_NO=
LESHOUYING_INSTITUTION_KEY=
LESHOUYING_NOTIFY_URL=
LESHOUYING_TIMEOUT_MS=5000
BILLING_RECONCILE_INTERVAL_MS=15000

# 可观测性配置可以留空。设置后应用通过 OTLP HTTP 导出。
OTEL_SERVICE_NAME=cb-authoring-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
