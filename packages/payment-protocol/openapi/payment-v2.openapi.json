            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Current identity or payment could not be accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/v2/payments/by-request-key/{requestKey}": {
      "get": {
        "operationId": "findRecoverablePayment",
        "security": [
          {
            "currentSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative logical payment and current channel attempt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoverablePaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Current identity or payment could not be accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Current identity or payment could not be accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Current identity or payment could not be accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          },
          "404": {
