            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoverablePaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Current identity or payment could not be accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Current identity or payment could not be accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Current identity or payment could not be accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Current identity or payment could not be accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          },
          "409": {
