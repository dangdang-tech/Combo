{
  "openapi": "3.1.0",
  "info": {
    "title": "Combo recoverable checkout API",
    "version": "2.0.0",
    "description": "Opt-in extension to the unchanged v1 payment/402/three-field Host protocol. Limits: three total channel attempts, 24 hours from logical payment creation. No automatic payment or business replay."
  },
  "paths": {
    "/v2/payments": {
      "post": {
        "operationId": "createRecoverablePayment",
        "security": [
          {
            "currentSession": []
          }
        ],
        "responses": {
          "201": {
            "description": "Authoritative logical payment and current channel attempt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoverablePaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Current identity or payment could not be accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Current identity or payment could not be accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Current identity or payment could not be accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Current identity or payment could not be accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Current identity or payment could not be accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Current identity or payment could not be accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentApiErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "Authoritative logical payment and current channel attempt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoverablePaymentResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentBody"
              }
            }
          }
        }
      }
    },
    "/v2/payments/{paymentId}": {
      "get": {
        "operationId": "getRecoverablePayment",
        "security": [
          {
            "currentSession": []
          }
        ],
        "responses": {
